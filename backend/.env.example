# Copy this file to backend/.env and fill in real values.
# None of this is committed — backend/.env is gitignored.

# --- Exasol connection (required for register/login/forms/sessions) ---
EXASOL_HOST=127.0.0.1
EXASOL_PORT=18563
EXASOL_USER=SYS
EXASOL_PASSWORD=

# --- JWT auth tokens ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Google Sign-In (required for the "Sign in with Google" button) ---
GOOGLE_CLIENT_ID=

# --- 2Factor.in SMS OTP (required for phone verification during /verify) ---
TWOFACTOR_API_KEY=
